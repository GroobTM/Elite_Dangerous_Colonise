<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="author" content="GroobTM" />
    <meta property="og:title" content="@ViewData["Title"] - ED Colonise" />
    <meta property="og:site_name" content="ED Colonise" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:image" content="https://edcolonise.net/images/Expanding.svg" />
    <meta property="og:url" content="@ViewData["url"]" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - ED Colonise" />
    <meta name="twitter:description" content="@ViewData["Description"]" />
    <meta name="twitter:image" content="https://edcolonise.net/images/Expanding.svg" />
    <meta name="keywords" content="Elite Dangerous, colonisation, ED Colonise, EDColonise" />
    <title>@ViewData["Title"] - ED Colonise</title>
    <link rel="stylesheet" href="~/css/site_tailwind.css" asp-append-version="true"/>
    @await Html.PartialAsync("_Favicons")
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebApplication",
          "name": "ED Colonise",
          "url": "https://edcolonise.net",
          "description": "ED Colonise is a colonisation helper for the game Elite Dangerous.",
          "applicationCategory": "GameUtilityApplication",
          "operatingSystem": "All",
          "creator": {
            "@@type": "Person",
            "name": "GroobTM"
          }
        }
    </script>
</head>
<body data-theme="@ViewData["Theme"]" class="bg-web-black flex min-h-screen flex-col">
    <header class="border-web-white bg-accent border-b-2 2xl:pr-10 2xl:pl-10">
        <nav class="text-web-white pt-2.5 text-5xl font-[EUROCAPS] md:text-6xl 2xl:px-6 2xl:py-2.5">
            <div class="flex flex-col flex-wrap items-center justify-between 2xl:flex-row">
                <a href="~/" class="mb-3 flex flex-col items-center md:flex-row 2xl:pb-0">
                    <img src="~/images/Expanding.svg" class="mr-5 h-15 md:h-25" />
                    <span class="self-center whitespace-nowrap">ED Colonise</span>
                </a>
                <button id="navbar_toggle" type="button" class="w-full cursor-pointer p-4 md:hidden" aria-controls="navbar" aria-expanded="false">
                    <svg id="navbar_icon" class="relative m-auto h-5 w-5 shrink-0 rotate-180 transition-transform duration-200" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5" />
                    </svg>
                </button>
                <div class="border-web-white hidden w-full border-t-2 md:block md:pt-3 md:pb-3 2xl:w-auto 2xl:border-t-0 2xl:pt-0 2xl:pb-0" id="navbar">
                    <div class="mt-0 grid grid-cols-1 text-4xl md:grid-cols-5">
                        <span class="w-full text-center 2xl:w-42">
                            <a href="~/" class="border-web-white mr-3 ml-3 block border-b-1 py-2 md:mr-0 md:ml-0 md:border-r-1 md:border-b-0 2xl:border-l-1 2xl:leading-20">Sol</a>
                        </span>
                        <span class="w-full text-center 2xl:w-42">
                            <a href="~/Colonia" class="border-web-white mr-3 ml-3 block border-b-1 py-2 md:mr-0 md:ml-0 md:border-r-1 md:border-b-0 2xl:leading-20">Colonia</a>
                        </span>
                        <span class="w-full text-center 2xl:w-42">
                            <a href="~/Sagittarius A*" class="border-web-white mr-3 ml-3 block border-b-1 py-2 whitespace-nowrap md:mr-0 md:ml-0 md:border-r-1 md:border-b-0 2xl:leading-20">Sgr A*</a>
                        </span>
                        <span class="w-full text-center 2xl:w-42">
                            <a href="~/Regions" class="border-web-white mr-3 ml-3 block border-b-1 py-2 md:mr-0 md:ml-0 md:border-r-1 md:border-b-0 2xl:leading-20">Regions</a>
                        </span>
                        <span class="w-full text-center 2xl:w-42">
                            <a asp-page="/About" class="border-web-white mr-3 ml-3 block py-2 md:mr-0 md:ml-0 md:border-r-1 2xl:leading-20">About</a>
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main class="min-h-100 pr-3 pl-3 sm:pr-10 sm:pl-10">
        @RenderBody()
    </main>
    <footer class="text-md border-web-white bg-accent text-web-white mt-auto flex flex-col gap-6 border-t-2 p-5 pt-8 text-center font-bold sm:gap-3 lg:pr-10 lg:pl-10">
        <p>
            Thanks to Gareth Harper for creating the amazing <a href="https://spansh.co.uk" target="_blank" class="text-blue-800 underline">Spansh</a> which provides the
            data dumps used by this tool.
        </p>
        <p>
            Thanks to the Elite Dangerous Community Developers for creating <a href="https://github.com/EDCD/EDDN" target="_blank" class="text-blue-800 underline">EDDN</a> which keeps this tool up to
            date.
        </p>
        <p>
            Thanks to CMDR SpyTec for recreating and providing the Elite Dangerous assets via
            <a href="https://edassets.org" target="_blank" class="text-blue-800 underline">Elite Dangerous Assets</a>.
        </p>
        <p>
            ED Colonise was created using assets and imagery from Elite Dangerous, with the permission of Frontier 
            Developments plc, for non-commercial purposes. It is not endorsed by nor reflects the views or opinions 
            of Frontier Developments and no employee of Frontier Developments was involved in the making of it.
        </p>
        <p>Please use the <a href="https://forums.frontier.co.uk/threads/introducing-edcolonise-net-a-colonisation-candidate-finder.635882/" target="_blank" class="text-blue-800 underline">Fontier Forum</a> post to report any bugs or issues with the tool.</p>
        <p>Tool Created by CMDR GroobTM.</p>
        <div class="flex w-full justify-center gap-5">
            <a asp-page="PrivacyPolicy" class="self-center text-blue-800 underline">Privacy Policy</a>
            <a asp-page="Licences" class="self-center text-blue-800 underline">Licences</a>
        </div>
        <div class="flex w-full justify-between">
            <a href="https://dashboard.simpleanalytics.com/?utm_source=edcolonise.net&utm_content=badge" referrerpolicy="origin" target="_blank">
                <picture>
                    <img src="https://simpleanalyticsbadges.com/edcolonise.net?mode=dark&logo=F07B05&background=F0F0F0&text=0F0F0F&radius=6" loading="lazy" referrerpolicy="no-referrer" crossorigin="anonymous" />
                </picture>
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $("#navbar_toggle").on("click", function () {
            $("#navbar_icon").toggleClass("rotate-180");
            $("#navbar").toggleClass("hidden");
        });
    </script>
</body>
</html>