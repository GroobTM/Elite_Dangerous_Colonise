@page
@model elite_dangerous_colonise.Pages.RegionsModel
@{
	ViewData["Title"] = "Regions";
	ViewData["Description"] = "This page displays all search regions in the galaxy.";
	ViewData["url"] = "https://edcolonise.net/Regions";
	ViewData["Theme"] = "None";
}

@section Scripts {
    <script src="~/lib/leaflet/leaflet.min.js"></script>
    <script>
        window.serverRegions = @Json.Serialize(Model.Regions);
    </script>
    <script src="~/js/regions.js"></script>
}
<link rel="stylesheet" href="~/lib/leaflet/leaflet.min.css" />
<style>
    .leaflet-control-layers input {
        transform: translateY(-4px);
        border-radius: 2px;
        cursor: pointer;
    }
</style>

<div id="map" class="my-3 h-[70vh] w-full !bg-black sm:my-10"></div>

