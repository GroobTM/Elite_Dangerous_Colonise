@page
@model elite_dangerous_colonise.Pages.RegionsModel
@{
	ViewData["Title"] = "Regions";
	ViewData["Description"] = "This page displays all search regions in the galaxy.";
	ViewData["url"] = "https://edcolonise.net/Regions";
	ViewData["Theme"] = "None";
}

@section Scripts {
    <script src="~/lib/leaflet/leaflet.min.js"></script>
    <script>
        window.serverRegions = @Json.Serialize(Model.Regions);
    </script>
    <script src="~/js/regions.js"></script>
}
<link rel="stylesheet" href="~/lib/leaflet/leaflet.min.css" />
<style>
    .leaflet-control-layers input {
        transform: translateY(-4px);
        border-radius: 2px;
        cursor: pointer;
    }
</style>

<h1 class="text-web-white pt-3 pb-3 text-center text-6xl font-[EUROCAPS]">Regions</h1>
<div id="map" class="h-[70vh] w-full !bg-black"></div>
<section id="card_grid" class="bg-web-white mt-3 mb-3 grid grid-cols-1 gap-2 rounded-md p-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6"></section>
